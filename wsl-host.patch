From 47b23831bb69433fe09cc214f3fd73654aa16378 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 14 Oct 2026 09:38:47 +0900
Subject: [PATCH] Add WSL host (wsl-x86_64 / wsl-aarch64) with CLI-only modules

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FYL6g8uKKXiERLudWLPrTb
---
 flake.nix                      | 53 ++++++++++++++++++++++++++--------
 home/wsl.nix                   | 50 ++++++++++++++++++++++++++++++++
 hosts/wsl/default.nix          | 23 +++++++++++++++
 modules/nixos/packages-cli.nix | 36 +++++++++++++++++++++++
 modules/nixos/wsl.nix          | 24 +++++++--------
 5 files changed, 161 insertions(+), 25 deletions(-)
 create mode 100644 home/wsl.nix
 create mode 100644 hosts/wsl/default.nix
 create mode 100644 modules/nixos/packages-cli.nix

diff --git a/flake.nix b/flake.nix
index ea10752..917fc7d 100644
--- a/flake.nix
+++ b/flake.nix
@@ -14,29 +14,58 @@
       url = "github:nix-community/home-manager";
       inputs.nixpkgs.follows = "nixpkgs";
     };
+
+    # WSL 向け（hosts/wsl だけが使う。デスクトップ構成には影響しない）
+    nixos-wsl = {
+      url = "github:nix-community/NixOS-WSL";
+      inputs.nixpkgs.follows = "nixpkgs";
+    };
   };
 
   # 💡 2. 引数（Outputs）に home-manager を受け取ります
-  outputs = { self, nixpkgs, home-manager, ... }@inputs: {
-    nixosConfigurations = {
-      # 👇 ここは今動いているマシンのホスト名（おそらく "nixos"）に合わせます
-      nixos = nixpkgs.lib.nixosSystem {
-        system = "x86_64-linux";
+  outputs = { self, nixpkgs, home-manager, ... }@inputs:
+    let
+      # WSL ホストを system（CPU アーキテクチャ）ごとに作る関数
+      mkWsl = system: nixpkgs.lib.nixosSystem {
+        inherit system;
         specialArgs = { inherit inputs; };
-
         modules = [
-          ./hosts/nixos/default.nix
-          ./noctalia.nix
-          # 💡 3. ここで Home Manager のモジュールをシステムに合体させます！
+          ./hosts/wsl/default.nix
           home-manager.nixosModules.home-manager
           {
             home-manager.useGlobalPkgs = true;
             home-manager.useUserPackages = true;
-            # 👇 Chronoさん専用の home.nix を読み込む配線
-            home-manager.users.chronotokei = import ./home/home.nix;
+            home-manager.users.nixos = import ./home/wsl.nix;
           }
         ];
       };
+    in
+    {
+      nixosConfigurations = {
+        # 👇 ここは今動いているマシンのホスト名（おそらく "nixos"）に合わせます
+        nixos = nixpkgs.lib.nixosSystem {
+          system = "x86_64-linux";
+          specialArgs = { inherit inputs; };
+
+          modules = [
+            ./hosts/nixos/default.nix
+            ./noctalia.nix
+            # 💡 3. ここで Home Manager のモジュールをシステムに合体させます！
+            home-manager.nixosModules.home-manager
+            {
+              home-manager.useGlobalPkgs = true;
+              home-manager.useUserPackages = true;
+              # 👇 Chronoさん専用の home.nix を読み込む配線
+              home-manager.users.chronotokei = import ./home/home.nix;
+            }
+          ];
+        };
+
+        # WSL 用。WSL 内の `uname -m` に合わせて選ぶ
+        #   x86_64  -> .#wsl-x86_64
+        #   aarch64 -> .#wsl-aarch64 (Snapdragon 搭載 PC など)
+        wsl-x86_64 = mkWsl "x86_64-linux";
+        wsl-aarch64 = mkWsl "aarch64-linux";
+      };
     };
-  };
 }
diff --git a/home/wsl.nix b/home/wsl.nix
new file mode 100644
index 0000000..a6f04cd
--- /dev/null
+++ b/home/wsl.nix
@@ -0,0 +1,50 @@
+{ pkgs, ... }:
+
+# WSL 用の home-manager 設定。デスクトップ用 home/home.nix（niri・GTK など）は使わない。
+{
+  home.username = "nixos";
+  home.homeDirectory = "/home/nixos";
+  home.stateVersion = "26.05";
+  programs.home-manager.enable = true;
+
+  home.sessionVariables = {
+    EDITOR = "nvim";
+    LANG = "ja_JP.UTF-8";
+    FLAKE = "/home/nixos/nixconfig-desktop";
+  };
+
+  home.packages = with pkgs; [
+    nh
+    nix-output-monitor
+    nix-tree
+    comma
+    fastfetch
+    lazygit
+    ghq
+    ncdu
+  ];
+
+  programs.fish = {
+    enable = true;
+    shellAliases = {
+      ll = "ls -l";
+      gs = "git status";
+    };
+    # `uname -m` で x86_64 / aarch64 を選ぶ（flake.nix の wsl-<arch> に対応）
+    functions.nr = ''
+      sudo nixos-rebuild switch --flake $FLAKE#wsl-(uname -m) $argv
+    '';
+  };
+
+  programs.starship = {
+    enable = true;
+    enableFishIntegration = true;
+    settings = {
+      add_newline = false;
+      character = {
+        success_symbol = "[➜](bold green)";
+        error_symbol = "[➜](bold red)";
+      };
+    };
+  };
+}
diff --git a/hosts/wsl/default.nix b/hosts/wsl/default.nix
new file mode 100644
index 0000000..0fd51e5
--- /dev/null
+++ b/hosts/wsl/default.nix
@@ -0,0 +1,23 @@
+{ inputs, ... }:
+
+# WSL 用ホスト。デスクトップ用の hosts/common（niri・SDDM・Bluetooth など）は
+# 読み込まず、GUI 不要な共通モジュールだけを使う。
+{
+  imports = [
+    inputs.nixos-wsl.nixosModules.wsl
+    ../../modules/nixos/nix.nix
+    ../../modules/nixos/docker.nix
+    ../../modules/nixos/wsl.nix
+    ../../modules/nixos/packages-cli.nix
+  ];
+
+  networking.hostName = "nixos-wsl";
+
+  time.timeZone = "Asia/Tokyo";
+  i18n.defaultLocale = "ja_JP.UTF-8";
+
+  # docker は modules/nixos/docker.nix で有効化済み。WSL のユーザーを docker グループへ
+  users.users.nixos.extraGroups = [ "wheel" "docker" ];
+
+  system.stateVersion = "26.05";
+}
diff --git a/modules/nixos/packages-cli.nix b/modules/nixos/packages-cli.nix
new file mode 100644
index 0000000..5184df3
--- /dev/null
+++ b/modules/nixos/packages-cli.nix
@@ -0,0 +1,36 @@
+{ pkgs, ... }:
+
+# modules/nixos/packages.nix から GUI・ハードウェア依存のものを除いた CLI 専用版
+{
+  programs.nix-ld.enable = true;
+
+  environment.systemPackages = with pkgs; [
+    wget
+    curl
+    git
+    gh
+    docker-compose
+    neovim
+    gnumake
+    automake
+    cmake
+    gcc
+    gdb
+    nodejs
+    fzf
+    direnv
+    gnupg
+    htop
+    btop
+    ripgrep
+    fd
+    jq
+    bat
+    eza
+    zoxide
+    tmux
+    rustup
+    unzip
+    tree
+  ];
+}
diff --git a/modules/nixos/wsl.nix b/modules/nixos/wsl.nix
index e00ab6a..a242a8c 100644
--- a/modules/nixos/wsl.nix
+++ b/modules/nixos/wsl.nix
@@ -1,19 +1,17 @@
 { pkgs, ... }:
+
+# NixOS-WSL 固有の設定（hosts/wsl だけが import する）
 {
-  wsl.enable = true;
-  wsl.defaultUser = "nixos";
+  wsl = {
+    enable = true;
+    defaultUser = "nixos";
+    # Windows の PATH / exe を WSL から呼べるようにする（既定値を明示）
+    interop.includePath = true;
+    # Windows のスタートメニューに WSL 内の GUI アプリのショートカットを作る
+    startMenuLaunchers = true;
+  };
 
+  # ログインシェルは fish。starship / alias は home-manager 側(home/wsl.nix)で設定する
   programs.fish.enable = true;
   users.users.nixos.shell = pkgs.fish;
-
-  programs.starship.enable = true;
-  programs.fish.interactiveShellInit = ''
-    starship init fish | source
-  '';
-
-  programs.fish.shellAliases = {
-   nr = "sudo nixos-rebuild switch --flake .#nixos";
-   ll = "ls -l";
-   gs = "git status";
-  };
 }
